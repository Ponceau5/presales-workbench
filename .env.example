# Copy to .env.local. Keep real keys only on the machine running FastAPI.
PRESALES_MODEL_PROVIDER=auto
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k2.6
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.7-flash
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Optional SiliconFlow provider; select with PRESALES_MODEL_PROVIDER=siliconflow
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=THUDM/GLM-4-9B-0414
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Maximum simultaneous model generations (provider quota must allow this).
PRESALES_AGENT_CONCURRENCY=20
# Open reply connections, including users waiting for a model slot.
PRESALES_STREAM_CONNECTIONS=100

# Leave unset to retain SQLite; switch only after offline migration and acceptance.
# PRESALES_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/presales
PRESALES_DB_POOL_SIZE=20
# PostgreSQL tools must match the deployed major version.
# PRESALES_PG_DUMP=/path/to/pg_dump
